---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import { buildSchema } from '../lib/schema';
const { title, description, lang, page = 'home', faq, ogImage, datePublished } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, site);
const enURL = new URL(Astro.url.pathname.replace(/\/(en|zh)(\/|$)/, '/en$2'), site);
const zhURL = new URL(Astro.url.pathname.replace(/\/(en|zh)(\/|$)/, '/zh$2'), site);
// 社交卡片用 1920×1080 的真实产品截图，而不是 256px 的应用图标：
// 图标在 summary_large_image 卡片里会被拉伸/留白，抓取方也拿不到产品信息。
const socialImage = new URL(`${base}${ogImage ?? 'screenshots/01-big-screen.jpg'}`, site);
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const alternateLocale = lang === 'zh' ? 'en_US' : 'zh_CN';
const socialImageAlt = lang === 'zh'
  ? 'Porthole 在 Apple TV 大屏上显示 Telegram 会话列表'
  : 'Porthole showing a Telegram chat list on an Apple TV';
const schema = buildSchema({
  lang, page, site, base, canonical: canonical.href, title, description, faq, datePublished,
});
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {/* max-image-preview:large 让 Google 结果里可以出大图缩略图；max-snippet/-video-preview 解除摘要长度限制。 */}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={canonical.href} />
  <link rel="alternate" hreflang="en" href={enURL.href} />
  <link rel="alternate" hreflang="zh-Hans" href={zhURL.href} />
  <link rel="alternate" hreflang="x-default" href={enURL.href} />
  <link rel="icon" href={`${base}brand/favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" href={`${base}brand/icon-32.png`} sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e1420" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PortholeTV" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={alternateLocale} />
  <meta property="og:image" content={socialImage.href} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage.href} />
  <meta name="twitter:image:alt" content={socialImageAlt} />
  <title>{title}</title>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
</head>
<body class="bg-bg font-sans text-ink antialiased">
  <Header lang={lang} />
  <main><slot /></main>
  <Footer lang={lang} />
  <CloudflareAnalytics />
</body>
</html>
