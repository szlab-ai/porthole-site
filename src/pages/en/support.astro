---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';

// FAQ 是可见正文与 FAQPage 结构化数据的唯一来源：Google 要求 schema 里的问答
// 与页面上肉眼可见的内容一致，所以两边都从这个数组渲染，避免改一处忘另一处。
const faq = [
  {
    q: 'How do I sign in?',
    a: 'Porthole uses your existing Telegram account. On first launch, enter your phone number and the login code Telegram sends you. Porthole never sees or stores your password.',
  },
  {
    q: 'How do I report or block content?',
    a: 'Open a message and use its action menu to <em>Report</em> or <em>Block</em>, or leave a chat. Objectionable content can also be reported to us by email.',
  },
  {
    q: 'What do I need to run Porthole?',
    a: 'An Apple TV running tvOS 17 or later, and a Telegram account.',
  },
  {
    q: 'Is this the official Telegram app?',
    a: 'No. Porthole is an independent, unofficial client and is not affiliated with or endorsed by Telegram.',
  },
];
---
<BaseLayout
  title="Support — PortholeTV for Apple TV"
  description="Get help with Porthole, the unofficial Telegram viewer for Apple TV: signing in, tvOS requirements, reporting content, and how to contact us."
  lang="en"
  page="support"
  faq={faq}
>
  <Prose title="Support">
    <p class="text-sm text-muted">An unofficial Telegram viewer for Apple TV</p>

    <p class="text-xs font-semibold uppercase tracking-wide text-muted">Contact</p>
    <p><a href="mailto:szlab.ai@outlook.com">szlab.ai@outlook.com</a></p>
    <p>We usually reply within a few business days. Please include your Apple TV model and tvOS version.</p>

    <h2>Frequently Asked Questions</h2>

    {faq.map((item) => (
      <>
        <h3>{item.q}</h3>
        <p set:html={item.a} />
      </>
    ))}

    <h2>Report Objectionable Content</h2>
    <p>Use the in-app report/block controls, or email <a href="mailto:szlab.ai@outlook.com">szlab.ai@outlook.com</a> with details. We act on reports promptly.</p>
  </Prose>
</BaseLayout>
