---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import VideoSection from '../../components/VideoSection.astro';
import Features from '../../components/Features.astro';
import Screenshots from '../../components/Screenshots.astro';
import TrustBar from '../../components/TrustBar.astro';
const lang = 'zh';
---
<BaseLayout
  title="PortholeTV — 在 Apple TV 上看 Telegram"
  description="在 Apple TV 上看 Telegram。PortholeTV（Porthole）是面向 tvOS 17 及以上系统的非官方 Telegram 查看应用，用 Siri Remote 浏览会话、群组与频道，在大屏上播放图片、视频、语音和文档。"
  lang={lang}
  page="home"
>
  <Hero lang={lang} /><VideoSection lang={lang} /><Features lang={lang} /><Screenshots lang={lang} /><TrustBar lang={lang} />
</BaseLayout>
