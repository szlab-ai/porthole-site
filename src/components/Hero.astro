---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const appStoreURL = lang === 'zh'
  ? 'https://apps.apple.com/hk/app/porthole-tv/id6788416143'
  : 'https://apps.apple.com/us/app/porthole-tv/id6788416143';
const badge = lang === 'zh'
  ? 'brand/download-on-the-app-store-zh-cn.svg'
  : 'brand/download-on-the-app-store-en.svg';
---
<section class="mx-auto max-w-5xl px-5 pt-20 pb-16 text-center">
  {/* 首屏 LCP 元素：显式 eager + 高优先级，避免被下方懒加载资源排到后面。 */}
  <img
    src={`${base}brand/porthole.png`}
    alt=""
    width="112"
    height="112"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="mx-auto mb-6 h-28 w-28 rounded-2xl shadow-sm"
  />
  {/* 标语并入 h1：原来的 h1 只有品牌名「Porthole」，不含任何用户会搜的词。
       视觉不变（同样两行、同样字号），但 h1 现在带上了产品描述。 */}
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    Porthole
    <span class="mt-3 block text-xl font-normal tracking-normal text-ink/90">{t('hero.tagline')}</span>
  </h1>
  <p class="mt-2 text-muted">{t('hero.subtitle')}</p>
  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
    <a
      href={appStoreURL}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      <img src={`${base}${badge}`} alt={t('hero.appStoreAlt')} height="52" class="h-11 w-auto sm:h-[52px]" />
    </a>
    <a
      href="https://t.me/PortholeTV_bot"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex h-11 items-center gap-2 rounded-lg border border-[#a6a6a6] bg-black px-3 text-left text-white hover:border-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:h-[52px]"
    >
      <span aria-hidden="true" class="relative mb-1 h-4 w-6 rounded-[3px] border-2 border-current after:absolute after:top-full after:left-1/2 after:mt-[4px] after:h-[2px] after:w-3 after:-translate-x-1/2 after:rounded-full after:bg-current"></span>
      <span class="flex flex-col gap-0.5">
        <span class="text-[11px] leading-none">{t('hero.viaTelegram')}</span>
        <span class="text-lg leading-none font-semibold sm:text-xl">Android TV</span>
      </span>
    </a>
  </div>
  <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-pretty text-muted">{t('hero.purchaseNote')}</p>
</section>
