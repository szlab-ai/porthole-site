---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const appStoreURL = lang === 'zh'
  ? 'https://apps.apple.com/hk/app/porthole-tv/id6788416143'
  : 'https://apps.apple.com/us/app/porthole-tv/id6788416143';
const badge = lang === 'zh'
  ? 'brand/download-on-the-app-store-zh-cn.svg'
  : 'brand/download-on-the-app-store-en.svg';
---
<section class="mx-auto max-w-5xl px-5 pt-20 pb-16 text-center">
  {/* 首屏 LCP 元素：显式 eager + 高优先级，避免被下方懒加载资源排到后面。 */}
  <img
    src={`${base}brand/porthole.png`}
    alt=""
    width="112"
    height="112"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="mx-auto mb-6 h-28 w-28 rounded-2xl shadow-sm"
  />
  {/* 标语并入 h1：原来的 h1 只有品牌名「Porthole」，不含任何用户会搜的词。
       视觉不变（同样两行、同样字号），但 h1 现在带上了产品描述。 */}
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    Porthole
    <span class="mt-3 block text-xl font-normal tracking-normal text-ink/90">{t('hero.tagline')}</span>
  </h1>
  <p class="mt-2 text-muted">{t('hero.subtitle')}</p>
  <a
    href={appStoreURL}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-8 inline-block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  >
    <img src={`${base}${badge}`} alt={t('hero.appStoreAlt')} height="52" class="h-[52px] w-auto" />
  </a>
</section>
